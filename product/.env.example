OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=ash
# Optional: separate models for verification and embeddings.
OPENAI_VERIFY_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
CRON_SECRET=replace-with-a-long-random-secret

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret-key
# Used to identify the logged-in session (Supabase Auth) — safe to be
# public in principle, but kept server-only here since all auth actions are
# mediated through same-origin API routes rather than a browser-side SDK.
SUPABASE_ANON_KEY=your-anon-public-key
# Optional aliases supported by the application and deployment integrations.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Either connection URL works for schema and migration commands.
POSTGRES_URL=postgresql://postgres:password@host:5432/postgres
POSTGRES_URL_NON_POOLING=postgresql://postgres:password@host:5432/postgres

# Optional source directory for `npm run db:migrate`.
VESTORY_DATA_DIR=

# PostHog (session replay + product analytics). Client-side SDK, so these
# are intentionally NEXT_PUBLIC_ (unlike the Supabase auth vars above).
# Leaving either unset disables PostHog entirely — no error, just a no-op.
# Host must match whichever region the project was created in:
# https://us.i.posthog.com or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
