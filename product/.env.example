OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=ash
# Optional: a separate, cheaper model for lib/podcast/verify.ts's fact-check pass.
# Falls back to OPENAI_TEXT_MODEL when unset.
OPENAI_VERIFY_MODEL=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret-key
# Needed only for `npm run db:schema` (applies supabase/migrations/*.sql directly over Postgres).
POSTGRES_URL_NON_POOLING=postgresql://postgres:password@host:5432/postgres
