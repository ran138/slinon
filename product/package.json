{
  "name": "vestory-product",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 5175",
    "build": "vite build",
    "build:next": "next build",
    "start": "next start --hostname 127.0.0.1 --port 5175",
    "test": "vitest run --config vitest.config.ts --exclude '**/*.integration.test.ts'",
    "test:integration": "node --env-file=.env.ingestion.local node_modules/vitest/vitest.mjs run tests/provider-quota.integration.test.ts tests/knowledge-chunks.integration.test.ts tests/knowledge-pipeline.integration.test.ts --config vitest.config.ts",
    "test:providers-live": "RUN_LIVE_PROVIDER_TESTS=1 node --env-file=.env.ingestion.local node_modules/vitest/vitest.mjs run tests/providers-live.integration.test.ts --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:schema": "node --env-file=.env.ingestion.local scripts/apply-supabase-schema.mjs",
    "db:migrate": "node --env-file=.env.ingestion.local scripts/migrate-sqlite-to-supabase.mjs",
    "knowledge:refresh": "node --env-file=.env.ingestion.local scripts/import-portfolio-knowledge.mjs",
    "local:start": "node scripts/local-supabase.mjs start",
    "local:stop": "node scripts/local-supabase.mjs stop",
    "local:reset": "node scripts/local-supabase.mjs reset",
    "local:status": "node scripts/local-supabase.mjs status",
    "ingest:daily": "tsx --env-file=.env.ingestion.local scripts/run-ingestion.ts daily",
    "ingest:backfill": "tsx --env-file=.env.ingestion.local scripts/run-ingestion.ts backfill"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fast-xml-parser": "^5.11.1",
    "gpt-tokenizer": "^4.0.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "music-metadata": "^11.15.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "openai": "^7.13.0",
    "postgres": "^3.4.9",
    "posthog-js": "^1.433.5",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "resend": "^6.28.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "better-sqlite3": "^13.0.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "supabase": "^2.117.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "vitest": "^4.0.18",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
